<?xml version="1.0" encoding="UTF-8"?>
<!-- Identité du logiciel autonome CAM2027 (lu par FreeCAD dans bin\branding.xml).
     Chemins relatifs au dossier d'installation. -->
<Branding version="1.0">
  <Application>CAM2027</Application>
  <WindowTitle>CAM2027</WindowTitle>
  <CopyrightInfo>CAM2027 - fork indépendant basé sur FreeCAD et son atelier CAM (LGPL-2.1+)</CopyrightInfo>
  <MaintainerUrl>https://github.com/storm8488/FreeCAD-CAM-2027</MaintainerUrl>
  <WindowIcon>branding/cam2027-icon.svg</WindowIcon>
  <ProgramLogo>branding/cam2027-logo.svg</ProgramLogo>
  <AboutImage>branding/cam2027-splash.svg</AboutImage>
  <SplashScreen>branding/cam2027-splash.svg</SplashScreen>
  <SplashTextColor>#F1F5FA</SplashTextColor>
  <SplashInfoColor>#AFBDCE</SplashInfoColor>
  <StartWorkbench>CAM2027Workbench</StartWorkbench>
  <ExeName>CAM2027</ExeName>
  <ExeVendor>CAM2027</ExeVendor>
  <ExeVersion>@VERSION@</ExeVersion>
  <AppDataSkipVendor>true</AppDataSkipVendor>
  <UserParameterTemplate>branding/user.cfg</UserParameterTemplate>
</Branding>
